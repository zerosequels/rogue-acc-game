{
  "name": "rogue-acc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "rogue/acc - a neural pachinko roguelike",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/simulate.ts",
    "smoke": "vite build && node tools/smoke.mjs",
    "upgrades": "tsx tools/upgrades.ts",
    "dev:lan": "vite --host 0.0.0.0",
    "propagation": "tsx tools/propagation.ts",
    "shot": "vite build && node tools/shot.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
